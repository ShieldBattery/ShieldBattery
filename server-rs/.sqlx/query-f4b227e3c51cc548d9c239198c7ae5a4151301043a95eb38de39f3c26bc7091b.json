  "query": "\n                    SELECT fam.id, fam.listed, cur.kind\n                    FROM maps m\n                    INNER JOIN map_families fam ON fam.id = m.family_id\n                    INNER JOIN maps cur ON cur.id = fam.current_map_id\n                    WHERE m.id = $1\n                ",
