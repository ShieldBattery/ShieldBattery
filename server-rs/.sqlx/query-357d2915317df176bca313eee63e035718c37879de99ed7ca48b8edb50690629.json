  "query": "\n            SELECT f.id as family_id, f.owner_id as \"owner_id: SbUserId\", f.listed,\n                cur.kind\n            FROM maps m\n            INNER JOIN map_families f ON f.id = m.family_id\n            INNER JOIN maps cur ON cur.id = f.current_map_id\n            WHERE m.id = $1\n        ",
