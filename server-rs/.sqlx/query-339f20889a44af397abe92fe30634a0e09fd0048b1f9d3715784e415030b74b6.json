  "query": "\n            INSERT INTO map_tags (id, kind, position, name, names, auto_rule)\n            SELECT $1, $2, COALESCE(max(position) + 1, 0), $3, $4, $5\n            FROM map_tags\n            WHERE kind = $2\n            RETURNING id, kind, name, names as \"names: Json<BTreeMap<String, String>>\", auto_rule\n        ",
