  "query": "\n                SELECT id, family_id, claimant as \"claimant: SbUserId\", note, status,\n                    resolved_by as \"resolved_by: SbUserId\", resolved_at, created_at\n                FROM map_owner_claims\n                WHERE status = $1\n                ORDER BY created_at, id\n                LIMIT $2 OFFSET $3\n            ",
