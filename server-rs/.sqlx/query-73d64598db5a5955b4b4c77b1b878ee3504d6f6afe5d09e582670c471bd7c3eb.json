{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT m.family_id, m.id as \"id: SbMapId\", m.listed as \"listed!\"\n                FROM maps m\n                WHERE m.family_id = ANY($1)\n                ORDER BY\n                    (SELECT s.games_total FROM map_stats s WHERE s.map_id = m.id)\n                        DESC NULLS LAST,\n                    m.first_seen_at DESC,\n                    m.id\n            ",
