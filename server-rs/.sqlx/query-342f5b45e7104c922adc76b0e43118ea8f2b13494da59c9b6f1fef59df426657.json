  "query": "\n                SELECT races, opponent_races,\n                    sum(wins)::integer AS \"wins!\", sum(losses)::integer AS \"losses!\"\n                FROM ladder_matchup_stats\n                WHERE matchmaking_type = $1 AND ($2::integer IS NULL OR season_id = $2)\n                GROUP BY races, opponent_races\n            ",
