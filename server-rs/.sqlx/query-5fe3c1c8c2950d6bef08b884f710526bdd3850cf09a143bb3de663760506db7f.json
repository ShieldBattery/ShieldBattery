  "query": "\n            SELECT game_type, sum(games)::bigint as \"games!\"\n            FROM map_stats_daily\n            WHERE map_id = $1 AND game_source = 'LOBBY' AND day >= $2\n            GROUP BY game_type\n            ORDER BY 2 DESC, game_type\n        ",
