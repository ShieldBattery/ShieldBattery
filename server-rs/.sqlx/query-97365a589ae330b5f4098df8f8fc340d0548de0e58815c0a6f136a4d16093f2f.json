  "query": "\n                SELECT\n                    g.start_time,\n                    g.game_length,\n                    EXISTS(\n                        SELECT 1 FROM games_users WHERE game_id = g.id AND user_id = $2\n                    ) AS \"played!\"\n                FROM games g\n                WHERE g.id = $1\n            ",
