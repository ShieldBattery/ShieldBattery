  "query": "\n            SELECT f.id, f.owner_id as \"owner_id: SbUserId\", f.owner_kind, f.credit,\n                m.name as \"name!\"\n            FROM map_families f\n            INNER JOIN maps m ON m.id = f.current_map_id\n            WHERE f.id = ANY($1) AND (f.owner_id IS NOT NULL OR f.credit IS NOT NULL)\n        ",
