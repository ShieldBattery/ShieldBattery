  "query": "\n            UPDATE map_tags\n            SET name = COALESCE($2, name), names = COALESCE($3, names),\n                auto_rule = CASE WHEN $4::boolean THEN $5::text ELSE auto_rule END,\n                updated_at = now()\n            WHERE id = $1\n            RETURNING id, kind, name, names as \"names: Json<BTreeMap<String, String>>\", auto_rule\n        ",
