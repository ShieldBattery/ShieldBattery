        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=~\"app_server|server_rs\"}, environment)",
        "hide": 0,
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "options": [],
        "query": "label_values(up{job=~\"app_server|server_rs\"}, environment)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=~\"app_server|server_rs\",environment=~\"$environment\"}, host)",
        "hide": 0,
        "includeAll": true,
        "label": "Host",
        "multi": true,
        "name": "host",
        "options": [],
        "query": "label_values(up{job=~\"app_server|server_rs\",environment=~\"$environment\"}, host)",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "utc",
  "title": "Server health",
  "uid": "server-health",
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Availability & traffic",
      "type": "row"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets up",
      "description": "Prometheus reachability for the TypeScript server, server-rs, and their shared host exporter.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "UP" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{job=~\"app_server|server_rs|node\",environment=~\"$environment\",host=~\"$host\"}",
          "legendFormat": "{{job}} / {{host}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "TypeScript process uptime",
      "description": "Time since the TypeScript server process started. A reset indicates a restart.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "time() - process_start_time_seconds{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP requests per second",
      "description": "Five-minute request rate for both application processes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, host) (rate(http_requests_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m]))",
          "legendFormat": "TypeScript / {{host}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, host) (rate(axum_http_requests_total{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m]))",
          "legendFormat": "server-rs / {{host}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 5xx percentage",
      "description": "Server-error requests divided by all requests over five minutes. A missing 5xx series is rendered as zero.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(100 * sum by (host) (rate(http_requests_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\",code=~\"5..\"}[5m])) / clamp_min(sum by (host) (rate(http_requests_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])), 1e-9)) or on (host) (0 * sum by (host) (rate(http_requests_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "TypeScript / {{host}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(100 * sum by (host) (rate(axum_http_requests_total{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\",status=~\"5..\"}[5m])) / clamp_min(sum by (host) (rate(axum_http_requests_total{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m])), 1e-9)) or on (host) (0 * sum by (host) (rate(axum_http_requests_total{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "server-rs / {{host}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Overall HTTP latency",
      "description": "Request-latency percentiles across all routes, calculated from each service's Prometheus histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, host) (rate(http_server_requests_seconds_bucket{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / TypeScript p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, host) (rate(http_server_requests_seconds_bucket{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / TypeScript p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, host) (rate(http_server_requests_seconds_bucket{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / TypeScript p99"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, host) (rate(axum_http_requests_duration_seconds_bucket{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / server-rs p50"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, host) (rate(axum_http_requests_duration_seconds_bucket{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / server-rs p95"
        },
        {
          "refId": "F",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, host) (rate(axum_http_requests_duration_seconds_bucket{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / server-rs p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "server-rs p95 latency by route",
      "description": "Slow-route view using Axum's matched route templates, which avoid raw-ID label cardinality.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 7 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, host, endpoint) (rate(axum_http_requests_duration_seconds_bucket{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / {{endpoint}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "server-rs in-flight requests",
      "description": "Currently executing server-rs requests by matched route template.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (host, endpoint) (axum_http_requests_pending{job=\"server_rs\",environment=~\"$environment\",host=~\"$host\"})",
          "legendFormat": "{{host}} / {{endpoint}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 9,
      "panels": [],
      "title": "TypeScript process & host resources",
      "type": "row"
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "TypeScript runtime pauses",
      "description": "Node event-loop delay p99 and garbage-collection duration p99.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 0 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * nodejs_eventloop_lag_p99_seconds{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}",
          "legendFormat": "{{host}} / event loop p99"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * histogram_quantile(0.99, sum by (le, host) (rate(nodejs_gc_duration_seconds_bucket{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])))",
          "legendFormat": "{{host}} / GC p99"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "TypeScript process CPU",
      "description": "CPU time consumed by the TypeScript server. One fully used CPU core is 100%.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * rate(process_cpu_seconds_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[5m])",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "TypeScript process memory",
      "description": "Resident memory and V8 heap usage for the TypeScript server process.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 5 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "process_resident_memory_bytes{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}",
          "legendFormat": "{{host}} / RSS"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_heap_size_used_bytes{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}",
          "legendFormat": "{{host}} / heap used"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "nodejs_heap_size_total_bytes{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}",
          "legendFormat": "{{host}} / heap allocated"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Host CPU utilization",
      "description": "Host-wide CPU utilization from node_exporter; this includes every container and process on the selected host.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{job=\"node\",environment=~\"$environment\",host=~\"$host\",mode=\"idle\"}[5m])))",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Host memory utilization",
      "description": "Host-wide memory pressure from node_exporter, based on MemAvailable rather than only free pages.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\",environment=~\"$environment\",host=~\"$host\"} / node_memory_MemTotal_bytes{job=\"node\",environment=~\"$environment\",host=~\"$host\"})",
          "legendFormat": "{{host}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Host root filesystem utilization",
      "description": "Used percentage of the selected host's root filesystem.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\",environment=~\"$environment\",host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"node\",environment=~\"$environment\",host=~\"$host\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "{{host}} / {{device}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 16,
      "panels": [],
      "title": "Database & telemetry delivery",
      "type": "row"
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "PostgreSQL pool utilization",
      "description": "Checked-out connections divided by each process's configured pool maximum.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * database_pool_connections{job=~\"app_server|server_rs\",environment=~\"$environment\",host=~\"$host\",state=\"in_use\"} / on (job, instance, environment, host) clamp_min(database_pool_max_connections{job=~\"app_server|server_rs\",environment=~\"$environment\",host=~\"$host\"}, 1)",
          "legendFormat": "{{job}} / {{host}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "PostgreSQL pool connections",
      "description": "Idle and checked-out connections for both processes, with each configured maximum overlaid.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
