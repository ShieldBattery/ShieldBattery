  "title": "Game loading & connections",
  "uid": "game-loading",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Game loads",
      "type": "row"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Game-load outcomes per second",
      "description": "Game-load requests, successes, and failures by source (lobby vs matchmaking) over fifteen minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host, game_source) (rate(shieldbattery_game_loader_requests_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[15m]))",
          "legendFormat": "{{host}} / {{game_source}} / requested"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host, game_source) (rate(shieldbattery_game_loader_successes_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[15m]))",
          "legendFormat": "{{host}} / {{game_source}} / succeeded"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host, game_source) (rate(shieldbattery_game_loader_failures_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[15m]))",
          "legendFormat": "{{host}} / {{game_source}} / failed"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Game-load failure percentage",
      "description": "Failed game loads as a percentage of requested loads, by source.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (host, game_source) (rate(shieldbattery_game_loader_failures_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[15m])) / clamp_min(sum by (host, game_source) (rate(shieldbattery_game_loader_requests_total{job=\"app_server\",environment=~\"$environment\",host=~\"$host\"}[15m])), 1)",
          "legendFormat": "{{host}} / {{game_source}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
