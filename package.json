{
  "name": "shieldbattery",
  "version": "11.3.1",
  "private": true,
  "description": "The modern way to play StarCraft: Brood War.",
  "keywords": [
    "brood war",
    "shieldbattery",
    "starcraft"
  ],
  "homepage": "https://github.com/tec27/shieldbattery#readme",
  "bugs": {
    "url": "https://github.com/tec27/shieldbattery/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tec27/shieldbattery.git"
  },
  "license": "MIT",
  "author": "Travis Collins <travis@tec27.com> (http://tec27.com/)",
  "main": "index.js",
  "engines": {
    "node": ">= 24.0.0"
  },
  "scripts": {
    "app": "pnpm run build-app-main && SB_HOT=1 electron app",
    "build-app-main": "NODE_ENV=development rolldown -c rolldown.app.config.ts",
    "build-app-client": "vite build -c vite.electron.config.ts && rolldown -c rolldown.app.config.ts",
    "build-game": "cmd /c \"game\\build.bat release x86\" && cmd /c \"game\\build.bat release x86_64\"",
    "build-server": "tsdown -c tsdown.server.config.ts",
    "build-web-client": "vite build",
    "check-circular": "madge --circular --extensions ts,tsx,js,jsx --exclude \"/dist/\" ./app ./client ./server",
    "check-orphans": "madge --orphans --extensions ts,tsx,js,jsx --exclude \"/dist/|[.]test[.]|/migrations/|/testing/\" ./app ./client ./server",
    "clean": "rimraf app/dist",
    "dev": "vite -c vite.electron.config.ts",
    "dist": "pnpm run clean && pnpm run build-app-client && pnpm run build-game && node tools/codesign/with-pin.cjs electron-builder build --win --x64 -p always -c prod.yml",
    "diststaging": "pnpm run clean && SB_SERVER=https://staging.shieldbattery.net pnpm run build-app-client && pnpm run build-game && node tools/codesign/with-pin.cjs electron-builder build --win --x64 -p always -c staging.yml",
    "download-fonts": "node -r @swc-node/register download-fonts.ts",
    "email-dev": "email dev --dir email/templates --port 5567",
    "format": "oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx}\"",
    "gen-emails": "node -r @swc-node/register email/generate.tsx",
    "gen-graphql": "graphql-codegen --config graphql-codegen.ts",
    "gen-minimap-previews": "node -r @swc-node/register tools/gen-minimap-previews.ts",
    "gen-schema": "cd ./server-rs && cargo run --bin gen-schema",
    "gen-translations": "pnpm gen-translations:app && pnpm gen-translations:email",
    "gen-translations:app": "i18next-cli extract --sync-primary",
    "gen-translations:email": "i18next-cli extract --sync-primary -c email/i18next.config.mjs",
    "gen-typeshare": "typeshare ./server-rs --lang=typescript --output-file=common/typeshare.ts && oxfmt common/typeshare.ts",
    "i18n": "node -r @swc-node/register tools/i18n-translate.ts",
    "installall": "cd app && pnpm install && cd .. && pnpm install && electron-builder install-app-deps",
    "lint": "oxlint && pnpm run format:check",
    "lint:fix": "oxlint --fix && pnpm run format",
    "local-dev": "run-pty local-dev.json",
    "migrate:create": "cargo sqlx migrate add",
    "migrate:run": "cargo sqlx migrate run",
    "overlay-preview:watch": "node game/overlay-ui/watch-preview.mjs",
    "pack": "pnpm run clean && pnpm run build-app-client && pnpm run build-game && node tools/codesign/with-pin.cjs electron-builder build --dir --win --x64 -c prod.yml",
    "packstaging": "pnpm run clean && SB_SERVER=https://staging.shieldbattery.net pnpm run build-app-client && pnpm run build-game && node tools/codesign/with-pin.cjs electron-builder build --dir --win --x64 -c staging.yml",
    "seed-dev": "node -r @swc-node/register tools/seed-dev-users.ts",
    "sqlx-prepare": "[ \"${NODE_ENV:-}\" = \"production\" ] && echo \"In production, not sqlx-preparing\" || (cd ./server-rs && cargo sqlx prepare --workspace -- --all-targets --all-features)",
    "start-server": "node --trace-warnings -r @swc-node/register ./server/app.ts | pino-pretty -c -t -i pid,hostname,req.headers,res.headers,req.remoteAddress,req.remotePort",
    "test": "vitest",
    "test-ui": "pnpm test --ui --coverage.enabled=true",
    "test:integration": "NODE_ENV=production playwright test",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    ">0.2%",
    "not ie 11",
    "not ie_mob 11",
    "not op_mini all",
    "not and_uc > 0",
    "not and_qq > 0",
    "not kaios > 0",
    "not ios_saf < 15",
    "not safari < 15",
    "not android < 120"
  ],
